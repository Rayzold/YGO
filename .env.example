# Copy to .env.local for local development. All three are public, browser-safe values.
# Supabase project URL and anon (public) key: Supabase dashboard > Project Settings > API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Public base URL of the card-image bucket, e.g. https://<project>.supabase.co/storage/v1/object/public/card-images
VITE_IMAGE_BASE=
