# Optional overrides for local development (copy to .env.local).
# Defaults live in src/lib/config.ts (the YGO Supabase project). All values are public.
# VITE_SUPABASE_URL=off            # run without Supabase (local mode)
# VITE_SUPABASE_URL=https://<project>.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# VITE_IMAGE_BASE=https://<project>.supabase.co/storage/v1/object/public/card-images
